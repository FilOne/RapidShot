<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RapidShot</AssemblyName>
    <RootNamespace>RapidShot</RootNamespace>
    <Version>1.24.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 WhiteHillTeam and contributors</Copyright>
    <ApplicationIcon>..\..\installer\assets\RapidShot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\shutter.wav" LogicalName="RapidShot.Assets.shutter.wav" />
    <PackageDownload Include="TesseractOCR" Version="[5.5.2]" />
    <Content Include="$(NuGetPackageRoot)tesseractocr\5.5.2\x64\tesseract.exe;$(NuGetPackageRoot)tesseractocr\5.5.2\x64\tesseract55.dll;$(NuGetPackageRoot)tesseractocr\5.5.2\x64\leptonica-1.85.0.dll"
             Link="ocr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="OcrData\*.traineddata" Link="ocr\tessdata\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="OcrData\LICENSE*;OcrData\README.ijg;OcrData\NOTICE.md" Link="ocr\licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
